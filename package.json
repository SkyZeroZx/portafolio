{
	"name": "portafolio-jaime_burgos_tejada",
	"description": "portafolio",
	"version": "2.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"format": "prettier --write \"./src/**/*.{ts,json,html}\"",
		"production": "ng build --configuration production",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"sonar": "sonar-scanner",
		"dev:ssr": "ng serve",
		"serve:ssr": "node dist/portafolio/server/server.mjs",
		"build:ssr": "ng build --configuration production",
		"prerender": "ng build --configuration production",
		"lint": "ng lint",
		"deploy:cloudflare": "npm run build && wrangler deploy",
		"deploy:cloudflare:dry-run": "npm run build && wrangler deploy --dry-run",
		"prepare": "husky install",
		"lint-format": "npm run format && ng lint --fix",
		"pre-commit": "npm run lint-format && git add ."
	},
	"private": true,
	"dependencies": {
		"@angular/common": "^22.2.3",
		"@angular/compiler": "^22.2.3",
		"@angular/core": "^22.2.3",
		"@angular/platform-browser": "^22.2.3",
		"@angular/platform-server": "^22.2.3",
		"@angular/router": "^22.2.3",
		"@angular/ssr": "^22.2.3",
		"@fortawesome/angular-fontawesome": "^5.0.0",
		"@fortawesome/fontawesome-svg-core": "^7.3.0",
		"@fortawesome/free-brands-svg-icons": "^7.3.0",
		"@fortawesome/free-solid-svg-icons": "^7.3.0",
		"@ngx-translate/core": "^18.0.0",
		"@ngx-translate/http-loader": "^18.0.0",
		"express": "^5.2.1",
		"ngx-typed-writer": "^1.7.0",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular-eslint/builder": "22.6.0",
		"@angular-eslint/eslint-plugin": "22.6.0",
		"@angular-eslint/eslint-plugin-template": "22.6.0",
		"@angular-eslint/schematics": "22.6.0",
		"@angular-eslint/template-parser": "22.6.0",
		"@angular/build": "^22.2.3",
		"@angular/cli": "~22.2.3",
		"@angular/compiler-cli": "^22.2.3",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@typescript-eslint/eslint-plugin": "8.62.1",
		"@typescript-eslint/parser": "8.62.1",
		"angular-eslint": "^22.0.0",
		"autoprefixer": "^10.5.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-prettier": "^5.5.7",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.10",
		"pretty-quick": "^4.2.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^4.1.12",
		"wrangler": "^4.151.3"
	}
}
